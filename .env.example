# Next.js Application Environment
PORT=3000
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Database (PostgreSQL with pgvector)
# Never commit real credentials. Copy this file to .env and fill in secrets.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/specwise_db?schema=public"

# MinIO Object Storage
MINIO_ENDPOINT="localhost"
MINIO_PORT="9000"
MINIO_USE_SSL="false"
MINIO_ACCESS_KEY=""
MINIO_SECRET_KEY=""
MINIO_BUCKET_NAME="specwise-attachments"

# Docker Compose service credentials (required by docker-compose.yml)
POSTGRES_USER=""
POSTGRES_PASSWORD=""
MINIO_ROOT_USER=""
MINIO_ROOT_PASSWORD=""

# KKU SSONext (OIDC) & OAuth2
KKU_SSO_CLIENT_ID=""
KKU_SSO_CLIENT_SECRET=""
KKU_SSO_ISSUER="https://ssonext.kku.ac.th"
KKU_SSO_AUTHORIZATION_URL="https://ssonext.kku.ac.th/oauth/authorize"
KKU_SSO_TOKEN_URL="https://ssonext.kku.ac.th/oauth/token"
KKU_SSO_USERINFO_URL="https://ssonext.kku.ac.th/oauth/userinfo"

# KKU Employee API v3
KKU_EMPLOYEE_API_URL="https://api-v3.kku.ac.th/employee"
KKU_EMPLOYEE_API_KEY=""

# Google Workspace Auth (Optional Fallback)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# KKU IntelSphere LLM (OpenAI-compatible)
KKU_INTELSPHERE_BASE_URL="https://intelsphere.kku.ac.th/v1"
KKU_INTELSPHERE_API_KEY=""
KKU_INTELSPHERE_MODEL="llama-3.3-70b-instruct"

# Mode Controls (Mock adapters for LOCAL OFFLINE development only)
# These are forcibly disabled in production builds (NODE_ENV=production).
ENABLE_MOCK_AUTH="false"
ENABLE_MOCK_AI="false"
ENABLE_MOCK_STORAGE="false"
ENABLE_MOCK_DATA="false"
