# Next.js Application Environment
PORT=3000
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Database (PostgreSQL with pgvector)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/specwise_db?schema=public"

# MinIO Object Storage
MINIO_ENDPOINT="localhost"
MINIO_PORT="9000"
MINIO_USE_SSL="false"
MINIO_ACCESS_KEY="specwise_minio_admin"
MINIO_SECRET_KEY="specwise_secure_pass_2026"
MINIO_BUCKET_NAME="specwise-attachments"

# KKU SSONext (OIDC / OAuth2) - Aligned with KKU_SSONext.postman_collection.json
KKU_SSO_API_URL="https://ssonext-api.kku.ac.th"
KKU_SSO_AUTHORIZATION_URL="https://ssonext.kku.ac.th/oauth/authorize"
KKU_SSO_CLIENT_ID="kku-specwise-client-id"
KKU_SSO_CLIENT_SECRET="kku-specwise-client-secret"
KKU_SSO_REDIRECT_URI="http://localhost:3000/api/auth/ssonext/callback"

# KKU Employee API v3 - Aligned with api-v3-employee.postman_collection.json
KKU_EMPLOYEE_API_URL="https://api.kku.ac.th/v3"
KKU_EMPLOYEE_CLIENT_ID="xxxxxxxxxx"
KKU_EMPLOYEE_SECRET_KEY="xxxxxxxxxx"


# Google Workspace Auth (Optional Fallback)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# KKU IntelSphere LLM (OpenAI-compatible)
KKU_INTELSPHERE_BASE_URL="https://intelsphere.kku.ac.th/v1"
KKU_INTELSPHERE_API_KEY="kku-intelsphere-api-key"
KKU_INTELSPHERE_MODEL="llama-3.3-70b-instruct"

# Mode Controls (Mock adapters for offline development)
ENABLE_MOCK_AUTH="true"
ENABLE_MOCK_AI="true"
ENABLE_MOCK_STORAGE="true"
